{
  "name": "flowg",
  "version": "0.0.0-internal",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:format": "sh scripts/i18n-format.sh",
    "i18n:compile": "npm run i18n:format && sh scripts/i18n-compile.sh",
    "predev": "npm run i18n:compile",
    "dev": "vite",
    "build": "npm run i18n:compile && tsc -b && vite build",
    "build:dev": "npm run i18n:compile && tsc -b && vite build --mode development",
    "lint": "oxlint . && prettier --check .",
    "format": "oxlint --fix . && prettier --write ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.1.2",
    "@mui/x-date-pickers": "^9.16.0",
    "@xyflow/react": "^12.12.0",
    "ag-grid-react": "^36.2.0",
    "dagre": "^0.8.5",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "event-source-plus": "^0.1.15",
    "i18next": "^26.5.10",
    "i18next-http-backend": "^4.0.5",
    "react": "^19.3.1",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router": "^8.5.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "globals": "^17.13.0",
    "i18next-conv": "^17.0.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-compression2": "^2.5.3"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "i18next": {
      "typescript": "$typescript"
    }
  }
}
